+<script>
+  const image = document.querySelector<HTMLImageElement>("#daily-home-photo");
+
+  if (image) {
+    try {
+      const pool = JSON.parse(image.dataset.photoPool ?? "[]") as string[];
+      if (pool.length > 1) {
+        const today = new Date();
+        const dayNumber = Math.floor(
+          Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()) / 86400000,
+        );
+        image.src = pool[Math.abs(dayNumber) % pool.length];
+      }
+    } catch {
+      // Keep the server-rendered fallback if the photo pool cannot be read.
+    }
+  }
