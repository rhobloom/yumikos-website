---
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../../components/ProjectGallery";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
---

<Layout title={project.title}>
  <main class="preview">

    <ProjectGallery
      client:load
      images={project.images}
      title={project.title}
    />

    <h1>{project.title}</h1>

    <p>{project.description}</p>

    <p>
      {project.images.length} photograph{project.images.length === 1 ? "" : "s"}
    </p>

    <hr />

    <nav class="actions">
      <a href="/photography">
        &larr; Back to Photography
      </a>
    </nav>

  </main>
</Layout>

<style>
.preview {
  max-width: 700px;
  margin: 0 auto;
  padding: 4rem 1.5rem 8rem;
}

.preview h1 {
  margin-bottom: 1rem;
}

.preview p {
  margin-bottom: 1.5rem;
}

hr {
  margin: 3rem 0;
  border: none;
  border-top: 1px solid #ddd;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.actions a {
  font-size: 1.1rem;
  width: fit-content;
}

.actions a:hover {
  opacity: 0.6;
}
</style>