---
import Layout from "../../../../layouts/Layout.astro";
import Container from "../../../../components/Container.astro";
---

<Layout title="Consulting — Yumiko">
  <Container>
    <main class="service-page">
      <header class="service-hero">
        <p class="eyebrow">Consulting</p>
        <h1>Turn good intentions<br /><em>into practice.</em></h1>
        <p class="intro">
          Thoughtful guidance for organizations and teams working toward more
          inclusive communication, policies, and everyday practices.
        </p>
      </header>

      <section class="content-grid">
        <div>
          <p class="label">What this can look like</p>
        </div>

        <div class="content">
          <p>
            Consulting creates space to look honestly at what is working,
            identify where people are getting stuck, and build practical ways
            forward.
          </p>

          <ul>
            <li>Organizational inclusion guidance</li>
            <li>Communication and language review</li>
            <li>Policy and practice consultation</li>
            <li>Customized support for teams and organizations</li>
          </ul>

          <a class="text-link" href="/contact">
            Start a conversation
            <span class="arrow" aria-hidden="true"></span>
          </a>
        </div>
      </section>
    </main>
  </Container>
</Layout>

<style>
  .service-page { padding: 5rem 0 8rem; }
  .service-hero { max-width: 65rem; padding: 4rem 0 7rem; }
  .eyebrow, .label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  h1 {
    margin: 1.5rem 0 2rem;
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.07em;
  }
  h1 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }
  .intro {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    line-height: 1.4;
  }
  .content-grid {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 5rem;
    padding: 4rem 0;
    border-top: 1px solid var(--color-line);
  }
  .content { max-width: 45rem; }
  .content > p {
    margin: 0 0 2.5rem;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  ul {
    margin: 0 0 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    list-style: none;
  }
  li {
    padding: 0.8rem 0;
    font-size: 1.1rem;
  }
  li + li { border-top: 1px solid var(--color-line); }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 700;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
  }
  .arrow {
    display: inline-block;
    position: relative;
    width: 1.1rem;
    height: 0.85rem;
    flex: 0 0 auto;
    background: currentColor;
    clip-path: polygon(
      0 43%, 68% 43%, 68% 8%, 100% 50%,
      68% 92%, 68% 57%, 0 57%
    );
  }
  @media (max-width: 700px) {
    .content-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
