---
import Container from "./Container.astro";
import { navigation } from "../data/navigation";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
  <Container>
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="brand" aria-label="Yumiko home">Yumiko</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" hidden>Menu</button>
      <div class="links" id="nav-links">
        {navigation.map((item, index) => (
          <div class="nav-item">
            <a href={item.href} class:list={{ "contact-link": item.label === "Contact" }} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>
            {item.children && (
              <>
                <button class="submenu-toggle" type="button" aria-label={`${item.label} submenu`} aria-expanded="false" aria-controls={`submenu-${index}`} hidden><span aria-hidden="true">⌄</span></button>
                <div class="dropdown" id={`submenu-${index}`}>
                  {item.children.map((child) => <a href={child.href} aria-current={currentPath === child.href ? "page" : undefined}>{child.label}</a>)}
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </nav>
  </Container>
</header>

<script>
  const nav = document.querySelector<HTMLElement>(".nav");
  if (nav) {
    const menu = nav.querySelector<HTMLButtonElement>(".menu-toggle")!;
    const toggles = [...nav.querySelectorAll<HTMLButtonElement>(".submenu-toggle")];
    nav.classList.add("enhanced");
    menu.hidden = false;
    toggles.forEach(button => {
      button.hidden = false;
      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") !== "true";
        toggles.forEach(other => other.setAttribute("aria-expanded", "false"));
        button.setAttribute("aria-expanded", String(open));
      });
    });
    menu.addEventListener("click", () => {
      const open = menu.getAttribute("aria-expanded") !== "true";
      menu.setAttribute("aria-expanded", String(open));
      menu.textContent = open ? "Close menu" : "Menu";
    });
    nav.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      const open = toggles.find(button => button.getAttribute("aria-expanded") === "true");
      if (open) { open.setAttribute("aria-expanded", "false"); open.focus(); }
      else if (menu.getAttribute("aria-expanded") === "true") { menu.click(); menu.focus(); }
    });
    const closeSubmenus = () => toggles.forEach(button => button.setAttribute("aria-expanded", "false"));
    document.addEventListener("click", event => { if (!nav.contains(event.target as Node)) closeSubmenus(); });
    nav.addEventListener("focusout", event => { if (!nav.contains(event.relatedTarget as Node)) closeSubmenus(); });
  }
</script>

<style>
header {
  position: sticky;
  top: 0;

  background: var(--color-bg);

  border-bottom: 1px solid #ececec;

  z-index: 100;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 5rem;
}

.brand {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.03em;

  color: var(--color-text);
  text-decoration: none;
}

.links {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-item {
  position: relative;

  display: flex;
  align-items: center;

  height: 5rem;
}

.links a {
  color: var(--color-text);
  text-decoration: none;
}

.links a:hover {
  color: var(--color-plum);
}

.dropdown {
  position: absolute;

  top: 100%;
  left: 50%;

  transform: translate(-50%, 8px);

  min-width: 220px;

  background: white;

  border: 1px solid #ececec;
  border-radius: .5rem;

  box-shadow: 0 12px 32px rgba(0,0,0,.08);

  padding: .5rem 0;

  opacity: 0;
  visibility: hidden;

  transition:
    opacity .18s ease,
    transform .18s ease;

  z-index: 1000;
}

.nav:not(.enhanced) .nav-item:hover .dropdown,
.nav:not(.enhanced) .nav-item:focus-within .dropdown,
.submenu-toggle[aria-expanded="true"] + .dropdown {
  opacity: 1;
  visibility: visible;

  transform: translate(-50%, 0);
}

.dropdown a {
  display: block;

  padding: .6rem 1rem;

  white-space: nowrap;
}

.dropdown a:hover {
  background: #f8f8f8;
}

.nav { gap: 1rem; }
.links { gap: 1.25rem; }
.links a { display: inline-flex; align-items: center; min-height: 44px; }
.links a[aria-current="page"] { text-decoration: underline; text-underline-offset: .3em; }
.dropdown a { display: flex; }
.menu-toggle, .submenu-toggle { font: inherit; color: inherit; cursor: pointer; background: transparent; border: 1px solid var(--color-line); border-radius: .4rem; min-height: 44px; }
.submenu-toggle { min-width: 44px; margin-left: .25rem; border-color: transparent; }
.menu-toggle { display: none; padding: .5rem .85rem; }
.contact-link { padding: .6rem 1.25rem; border: 1px solid var(--color-line); border-radius: var(--radius-pill); }
[hidden] { display: none !important; }
@media (max-width: 850px) {
  .nav { flex-wrap: wrap; min-height: 4.5rem; padding-block: .5rem; }
  .enhanced .menu-toggle { display: block; }
  .links { width: 100%; flex-direction: column; align-items: stretch; gap: .25rem; padding-bottom: .75rem; max-height: calc(100dvh - 5rem); overflow-y: auto; }
  .enhanced .menu-toggle[aria-expanded="false"] + .links { display: none; }
  .nav-item { height: auto; flex-wrap: wrap; justify-content: space-between; }
  .nav-item > a { flex: 1; padding: .65rem .5rem; }
  .dropdown { position: static; transform: none !important; min-width: 0; width: 100%; box-shadow: none; border: 0; border-left: 2px solid var(--color-line); margin: .25rem 0 .5rem .5rem; background: transparent; opacity: 1; visibility: visible; }
  .enhanced .dropdown { display: none; }
  .submenu-toggle[aria-expanded="true"] + .dropdown { display: block; }
  .dropdown a { white-space: normal; }
  .contact-link { justify-content: center; margin-top: .5rem; }
}
</style>