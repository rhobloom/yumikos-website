---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="section-header">
  <h2>{title}</h2>

  {intro && <p>{intro}</p>}
</header>

<style>
.section-header {
  margin-bottom: 3rem;
}

.section-header h2 {
  margin-bottom: .75rem;
}

.section-header p {
  max-width: 60ch;
  color: #666;
}
</style>