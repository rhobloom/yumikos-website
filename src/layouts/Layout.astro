---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";

interface Props {
  title?: string;
}

const { title = "Yumiko" } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#page-content">Skip to content</a>

  <Navigation />

  <div id="page-content" tabindex="-1"><slot /></div>
 <footer class="site-footer">
  <a
    href="https://rhobloom.art"
    class="footer-link"
    aria-label="Website designed by rhobloom"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img
      src="/images/rhobloom-v2.svg"
      alt="rhobloom"
      class="footer-mark"
    />
  </a>
</footer>

<style>
.site-footer {
  max-width: 1100px;

  margin: 8rem auto 2rem;

  padding: 0 2rem;

  display: flex;
  justify-content: flex-end;
}

.footer-link {
  display: inline-block;
}

.footer-mark {
  width: 180px;
  height: auto;

  opacity: .55;

  transition:
    opacity .25s ease,
    transform .25s ease;
}

.footer-mark:hover {
  opacity: 1;
  transform: translateY(-2px);
}
</style>

</body>
</html>